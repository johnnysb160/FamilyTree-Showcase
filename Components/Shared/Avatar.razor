@if (!string.IsNullOrWhiteSpace(Person.PhotoUrl))
{
    <div class="ft-avatar @Css"><img src="@Person.PhotoUrl" alt="" /></div>
}
else
{
    <div class="ft-avatar ft-avatar-@(Person.Sex == "F" ? "f" : "m") @Css"><span>@Initials</span></div>
}

@code {
    [Parameter, EditorRequired] public Relative Person { get; set; } = default!;
    [Parameter] public string? Css { get; set; }

    string Initials
    {
        get
        {
            var parts = Person.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Where(x => x.Length > 2 || char.IsUpper(x[0])).ToArray();
            if (parts.Length == 0) return "?";
            return (parts[0][..1] + (parts.Length > 1 ? parts[^1][..1] : "")).ToUpper();
        }
    }
}
