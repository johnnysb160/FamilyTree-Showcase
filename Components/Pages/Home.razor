@page "/"
@layout ShowcaseLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject FamilyTreeService TreeService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Árvore Genealógica</PageTitle>

<div class="sc">
    <header class="sc-header">
        <div class="sc-brand">
            <div class="sc-logo">
                <svg viewBox="0 0 48 48" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                    <circle cx="24" cy="9" r="5" /><circle cx="10" cy="39" r="5" /><circle cx="38" cy="39" r="5" /><circle cx="24" cy="39" r="5" />
                    <path d="M24 14v10M10 34v-5h28v5M24 24v10" />
                </svg>
            </div>
            <div>
                <h1>Árvore Genealógica</h1>
                <small>@relatives.Count pessoas · @Generations gerações · de @OldestYear até hoje</small>
            </div>
        </div>

        <nav class="sc-tabs" role="tablist">
            @foreach (var (num, title, _) in Views)
            {
                <button class="sc-tab @(view == num ? "active" : "")" @onclick="() => ChangeView(num)">@title</button>
            }
            <span class="sc-tab-indicator" style="--i:@(view - 1)"></span>
        </nav>

        <div class="sc-actions">
            <a class="sc-admin" href="admin" title="Administração">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z" stroke-linejoin="round" /></svg>
                <span>Admin</span>
            </a>
        </div>
    </header>

    <main class="sc-canvas @(panelCollapsed ? "panel-collapsed" : "")">
        <div class="sc-tree" @ref="canvas"></div>

        <div class="sc-panel @(panelCollapsed ? "collapsed" : "")">
            <button class="sc-panel-head" title="@(panelCollapsed ? "Expandir painel" : "Recolher painel")" @onclick="() => panelCollapsed = !panelCollapsed">
                @if (panelCollapsed && Focused is { } fc)
                {
                    <Avatar Person="fc" Css="ft-avatar-xs" />
                }
                <span class="sc-panel-title">@(panelCollapsed && Focused is { } fx ? $"Vendo: {FirstName(fx.Name)}" : Views[view - 1].Title)</span>
                <span class="sc-chevron"></span>
            </button>
            <div class="sc-panel-body">
                <div class="sc-panel-desc">@Views[view - 1].Description</div>
                @if (view == LineageView)
                {
                    <div class="sc-segmented">
                        <button class="@(lineageMode == "ancestors" ? "active" : "")" @onclick='() => ChangeMode("ancestors")'>Ancestrais</button>
                        <button class="@(lineageMode == "descendants" ? "active" : "")" @onclick='() => ChangeMode("descendants")'>Descendentes</button>
                    </div>
                }
                <div class="sc-links">
                    <button @onclick='() => Command("expandAll")'>Mostrar todos</button>
                    @if (view == LineageView)
                    {
                        <button @onclick='() => Command("collapseAll")'>Recolher</button>
                    }
                </div>
                @if (Focused is { } f)
                {
                    <div class="sc-focus">
                        <Avatar Person="f" Css="ft-avatar-xs" />
                        <span><small>Vendo a partir de</small><b>@f.Name</b></span>
                        @if (rootId != focusId)
                        {
                            <button class="sc-focus-reset" title="Voltar para @RootName" @onclick="() => Focus(rootId)">↺</button>
                        }
                    </div>
                    <button class="sc-focus-change" @onclick="() => pickerOpen = true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
                        Ver a partir de outra pessoa
                    </button>
                }
            </div>
        </div>

        <div class="sc-zoom">
            <button title="Aproximar" @onclick='() => Command("zoomIn")'>+</button>
            <button title="Afastar" @onclick='() => Command("zoomOut")'>−</button>
            <button title="Ajustar à tela" @onclick='() => Command("fit")'>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
            </button>
        </div>

        <div class="sc-legend">
            <span><i class="legend-m"></i>Homem</span>
            <span><i class="legend-f"></i>Mulher</span>
            <span><i class="legend-x">✝</i>Falecido</span>
        </div>
    </main>

    @if (showInvite && Focused is { } who)
    {
        <div class="sc-invite" role="status">
            <Avatar Person="who" Css="ft-avatar-xs" />
            <div class="sc-invite-text">
                <b>Você está vendo a árvore a partir de @FirstName(who.Name).</b>
                <span>É da família? Escolha seu nome e veja todos os parentescos a partir de você.</span>
            </div>
            <button class="sc-invite-go" @onclick="async () => { pickerOpen = true; await DismissInvite(); }">Escolher</button>
            <button class="sc-invite-x" title="Fechar" @onclick="DismissInvite">×</button>
        </div>
    }

    <RelativeDrawer Details="details" IsOpen="drawerOpen" FocusName="@Focused?.Name"
                    OnClose="() => drawerOpen = false"
                    OnNavigate="OpenDetails"
                    OnFocus="FocusFromDrawer" />

    <FocusPicker People="relatives" CurrentId="focusId" IsOpen="pickerOpen"
                 LabelOf="r => FamilyTreeService.Label(relatives, focusId, r)"
                 OnSelect="PickFocus" OnClose="() => pickerOpen = false" />
</div>

@code {
    // View ids = tab position (1-based)
    const int TreeView = 1, LineageView = 2;

    static readonly (int Num, string Title, string Description)[] Views =
    [
        (TreeView, "Árvore familiar", "Toda a família por geração. Setas dos cartões recolhem: ▲ pais, ▼ filhos, ◀ ▶ irmãos. Duplo clique centraliza."),
        (LineageView, "Linhagem", "Ramos em curvas com animação. Toque no círculo para expandir/recolher e no nome para ver detalhes.")
    ];

    // Point of view shared by link: /?foco=12 (otherwise the last choice saved in this browser, then the root)
    [SupplyParameterFromQuery(Name = "foco")] public int? FocusQuery { get; set; }

    ElementReference canvas;
    IJSObjectReference? module;
    DotNetObjectReference<Home>? self;

    List<Relative> relatives = [];
    int view = TreeView, rootId, focusId;
    string lineageMode = "ancestors";
    bool needsRender;
    bool drawerOpen;
    bool panelCollapsed;
    bool pickerOpen, showInvite;
    RelativeDetails? details;

    Relative? Focused => relatives.FirstOrDefault(r => r.Id == focusId);
    int OldestYear => relatives.Where(r => r.BirthDate is not null).Select(r => r.BirthDate!.Value.Year).DefaultIfEmpty(DateTime.Today.Year).Min();
    int Generations => Focused is null ? 0 : Depth(FamilyTreeService.Ancestors(relatives, focusId)) + Depth(FamilyTreeService.Descendants(relatives, focusId)) - 1;
    string RootName => relatives.FirstOrDefault(r => r.Id == rootId)?.Name ?? "";
    static string FirstName(string name) => name.Split(' ')[0];
    bool Exists(int? id) => id is { } x && relatives.Any(r => r.Id == x);
    static int Depth(TreeNode n) => 1 + (n.Children.Count == 0 ? 0 : n.Children.Max(Depth));

    protected override async Task OnInitializedAsync()
    {
        relatives = await TreeService.ListAsync();
        rootId = focusId = await TreeService.GetRootIdAsync();
        if (Exists(FocusQuery)) focusId = FocusQuery!.Value;
    }

    // Back/forward or an edited link changes ?foco=
    protected override void OnParametersSet()
    {
        if (relatives.Count > 0 && Exists(FocusQuery) && FocusQuery != focusId)
        {
            focusId = FocusQuery!.Value;
            needsRender = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/familyTree.js");
            // On phones the panel starts collapsed so the tree gets the whole screen
            panelCollapsed = await module.InvokeAsync<bool>("isPhoneScreen");
            // No focus in the link: reuse the person this visitor chose last time
            if (FocusQuery is null && await module.InvokeAsync<int?>("loadFocus") is { } saved && Exists(saved)) focusId = saved;
            showInvite = await module.InvokeAsync<bool>("isFirstVisit");
            needsRender = true;
            StateHasChanged();
            return;
        }
        if (needsRender && module is not null && relatives.Count > 0)
        {
            needsRender = false;
            if (view == LineageView)
                await module.InvokeVoidAsync("treegraph", canvas, FamilyTreeService.Treegraph(relatives, focusId, lineageMode == "ancestors"), self);
            else
                await module.InvokeVoidAsync("familyTree", canvas, FamilyTreeService.Family(relatives, focusId), focusId, self);
        }
    }

    void ChangeView(int v)
    {
        if (v == view) return;
        view = v;
        needsRender = true;
    }

    void ChangeMode(string mode)
    {
        lineageMode = mode;
        needsRender = true;
    }

    async Task Command(string cmd, object? arg = null)
    {
        if (module is not null) await module.InvokeVoidAsync("command", cmd, arg);
    }

    [JSInvokable]
    public void OpenDetails(int id)
    {
        details = FamilyTreeService.GetDetails(relatives, id, focusId);
        drawerOpen = details is not null;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task Refocus(int id) => InvokeAsync(() => Focus(id));

    // Changes the point of view: labels, generations and both views are rebuilt from this person
    async Task Focus(int id)
    {
        if (!Exists(id)) return;
        focusId = id;
        needsRender = true;
        if (drawerOpen && details is not null) details = FamilyTreeService.GetDetails(relatives, details.Person.Id, focusId);
        StateHasChanged();
        if (module is not null) await module.InvokeVoidAsync("saveFocus", id);
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("foco", id == rootId ? null : id), replace: true);
    }

    async Task PickFocus(int id)
    {
        pickerOpen = false;
        await Focus(id);
    }

    async Task FocusFromDrawer(int id)
    {
        drawerOpen = false;
        await Focus(id);
    }

    async Task DismissInvite()
    {
        showInvite = false;
        if (module is not null) await module.InvokeVoidAsync("markVisited");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("destroy");
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        self?.Dispose();
    }
}
